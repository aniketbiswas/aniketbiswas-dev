{
  "name": "aniketbiswas-portfolio",
  "description": "Aniket Biswas - Personal Portfolio Website",
  "version": "1.0.0",
  "author": "Aniket Biswas <aniketbiswas100@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/aniketbiswas/aniketbiswas-dev"
  },
  "keywords": [
    "gatsby"
  ],
  "license": "MIT",
  "browserslist": "> 0.25%, not dead",
  "scripts": {
    "build": "gatsby build",
    "develop": "gatsby develop",
    "dev": "nvm use 22 && gatsby develop",
    "format": "prettier --write \"**/*.{js,jsx,json,md}\"",
    "start": "npm run develop",
    "serve": "gatsby serve",
    "clean": "gatsby clean",
    "test:release": "node --test tests/portfolio-release.test.cjs",
    "release:plan": "node scripts/portfolio-release.cjs",
    "deploy": "node scripts/portfolio-release.cjs --deployment-disabled",
    "build:prod": "gatsby clean && gatsby build",
    "build:resume": "tectonic --untrusted --outdir static docs/resume.tex",
    "check:site": "node scripts/check-site.js",
    "test:site-health": "node --test scripts/check-site.test.js",
    "test:feed": "node --test scripts/medium-feed.test.js",
    "prepare": "husky install",
    "lint-staged": "lint-staged",
    "fix-husky": "rm -rf .husky && husky install && npx husky add .husky/pre-commit \"npm run lint-staged\""
  },
  "lint-staged": {
    "*.{js,css,json,md}": [
      "prettier --write"
    ],
    "*.js": [
      "eslint --fix"
    ]
  },
  "dependencies": {
    "@chenglou/pretext": "^0.0.4",
    "babel-plugin-styled-components": "^1.12.0",
    "gatsby": "^3.4.1",
    "gatsby-plugin-image": "^1.4.0",
    "gatsby-plugin-manifest": "^3.4.0",
    "gatsby-plugin-react-helmet": "^4.4.0",
    "gatsby-plugin-remove-serviceworker": "^1.0.0",
    "gatsby-plugin-sharp": "^3.4.1",
    "gatsby-plugin-sitemap": "^4.0.0",
    "gatsby-plugin-styled-components": "^4.4.0",
    "gatsby-remark-external-links": "0.0.4",
    "gatsby-remark-images": "^5.1.0",
    "gatsby-remark-prismjs": "^5.1.0",
    "gatsby-source-filesystem": "^3.4.0",
    "gatsby-transformer-remark": "^4.1.0",
    "gatsby-transformer-sharp": "^3.4.0",
    "lodash": "^4.17.19",
    "prismjs": "^1.27.0",
    "prop-types": "^15.7.2",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "react-helmet": "^6.1.0",
    "react-transition-group": "^4.3.0",
    "styled-components": "^5.3.0"
  },
  "devDependencies": {
    "@babel/core": "^7.14.0",
    "@babel/eslint-parser": "^7.13.14",
    "@babel/preset-react": "^7.13.13",
    "@upstatement/eslint-config": "^1.0.0",
    "@upstatement/prettier-config": "^1.0.0",
    "babel-preset-gatsby": "^1.4.0",
    "eslint": "^7.25.0",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-jsx-a11y": "^6.4.1",
    "eslint-plugin-react": "^7.23.2",
    "gatsby-remark-code-titles": "^1.1.0",
    "husky": "^6.0.0",
    "lint-staged": "^10.1.2",
    "prettier": "^2.2.1"
  }
}
